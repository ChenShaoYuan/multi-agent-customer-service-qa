# Copy this file to .env and fill in local values. Never commit .env.
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# Optional tracing. Keep disabled until a tracing account is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-customer-service-qa

LOG_LEVEL=INFO
RULE_VERSION=0.1.0
PROMPT_VERSION=0.1.0

