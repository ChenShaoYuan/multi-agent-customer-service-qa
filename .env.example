# Copy this file to .env and fill in local values. Never commit .env.
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# Alternatively, remove the empty LLM_API_KEY line and use DASHSCOPE_API_KEY.
# User-provided endpoint/model setup: docs/model-connection.md
LLM_TIMEOUT_SECONDS=30
# For Qwen hybrid-thinking models with forced structured output, uncomment:
# LLM_ENABLE_THINKING=false

# Optional tracing. Keep disabled until a tracing account is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-customer-service-qa

LOG_LEVEL=INFO
RULE_VERSION=0.1.0
PROMPT_VERSION=0.3.0

# Week-four rule lookup and bounded aggregation
RULES_TRANSPORT=local
MCP_RULES_URL=http://127.0.0.1:8765/mcp
MCP_TIMEOUT_SECONDS=10
SUMMARY_MAX_STEPS=4
